{
  "expo": {
    "name": "PetMate",
    "slug": "my-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "petmate",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "supportsRTL": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.petmate.app",
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "CFBundleLocalizations": ["en", "ar"],
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "1"
    },
    "android": {
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#0F172A"
      },
      "package": "com.petmate.app",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "68b8f9c2-4ec6-4fde-8b48-c945bfb1a33e"
      }
    },
    "plugins": [
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": ["en", "ar"],
            "android": ["en", "ar"]
          }
        }
      ],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0F172A",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#020617"
          }
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Inter-Regular.ttf",
            "./assets/fonts/Inter-Medium.ttf",
            "./assets/fonts/Inter-SemiBold.ttf",
            "./assets/fonts/Inter-Bold.ttf"
          ]
        }
      ],
      "expo-image",
      "@react-native-google-signin/google-signin",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "PetMate uses your location to find breeding partners near you. Your exact home location is never shown to others."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "PetMate needs access to your photos so you can add pictures of your pet."
        }
      ],
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "owner": "petmate_dev"
  }
}
